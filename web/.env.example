# 複製成 .env.local 再填（.env.local 不會上傳到 GitHub）
# Supabase → Project Settings → API Keys
# 這兩個值本來就會出現在瀏覽器裡，是公開的；權限由資料庫的 RLS 把關。
# 絕對不要放 secret / service_role 金鑰。
NEXT_PUBLIC_SUPABASE_URL=https://你的專案代號.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# v2.2.1（可以先不填）
# 聯絡信箱：填了會顯示在「聯絡我們」和隱私權政策
NEXT_PUBLIC_CONTACT_EMAIL=
# Discord 通知：「聯絡我們」有新訊息時通知網站管理員（只在伺服器端用，不要加 NEXT_PUBLIC_）
DISCORD_WEBHOOK_URL=
