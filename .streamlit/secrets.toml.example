# ============================================================
# 複製這個檔案成 secrets.toml（同一個資料夾）再填入內容。
# secrets.toml 已被 .gitignore 排除，不會上傳到 GitHub。
# 部署到 Streamlit Cloud 時，把同樣的內容貼到網站後台的 Secrets。
# ============================================================

# ---- 隊伍密碼（不設定 = 不需要密碼）----
team_password = "改成你的密碼"

# ---- 手動覆寫「給球隊的話」（有隊員名字，所以放這裡不放 settings.toml）----
[message_overrides]
"隊員姓名" = "無"

# ---- Google 試算表（不設定 = 讀本機 data/team.xlsx）----
[google_sheet]
url = "https://docs.google.com/spreadsheets/d/你的試算表ID/edit"
worksheet = "表單回覆 1"

# 服務帳號金鑰：把下載的 JSON 檔每個欄位照抄過來
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
