# 複製這個檔案成 .env（同一個資料夾）再填入內容。.env 已被 .gitignore 排除，不會上傳到 GitHub。
# 位置：Supabase 專案 → Project Settings → API Keys / Data API

# Project URL（例如 https://abcdefgh.supabase.co）
SUPABASE_URL=

# Publishable key（舊介面叫 anon key）：可以給前端用，權限受 RLS 規則限制
SUPABASE_PUBLISHABLE_KEY=

# Secret key（舊介面叫 service_role key）：可以繞過所有權限，只能放後端，絕對不能外流
SUPABASE_SECRET_KEY=

# 資料庫連線字串（Connect → Session pooler），把 [YOUR-PASSWORD] 換成建專案時設的資料庫密碼
DATABASE_URL=
